# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000
NODE_ENV=development

# Frontend URL(s) allowed to call the API (comma-separated)
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL – the database restored from boarding_lk_final_2026_11_07.backup
DB_HOST=localhost
DB_PORT=5432
DB_NAME=boarding_lk
DB_USER=postgres
DB_PASSWORD=your_postgres_password
# Or use a single connection string instead of the DB_* values above:
# DATABASE_URL=postgres://postgres:password@localhost:5432/boarding_lk

# Secret used to sign login tokens. Use a long random string, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d
